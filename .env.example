# MongoDB Connection
# Para desarrollo local: mongodb://localhost:27017/rick-and-morty-auth
# Para producción (MongoDB Atlas): mongodb+srv://username:password@cluster.mongodb.net/rick-and-morty-auth?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/rick-and-morty-auth

# JWT Secret Key
# Usa una cadena aleatoria y segura (mínimo 32 caracteres)
# Puedes generar una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Rick and Morty API (Ya está configurada, no cambiar)
NEXT_PUBLIC_API_URL=https://rickandmortyapi.com/api
